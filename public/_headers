# Vite fingerprints everything under /assets, so it can be cached forever.
# Without this, Workers Assets answers "max-age=0, must-revalidate" and every
# visit re-checks every script, stylesheet and font.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Brand images are not fingerprinted; a day is a safe balance.
/brand/*
  Cache-Control: public, max-age=86400
/mascot/*
  Cache-Control: public, max-age=86400
